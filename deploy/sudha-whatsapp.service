[Unit]
Description=Sudha Hospital WhatsApp Bot
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sudha_whatsapp
Environment="PATH=/home/ubuntu/sudha_whatsapp/.venv/bin"
EnvironmentFile=/home/ubuntu/sudha_whatsapp/.env
ExecStart=/home/ubuntu/sudha_whatsapp/.venv/bin/gunicorn -c deploy/gunicorn.conf.py app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
